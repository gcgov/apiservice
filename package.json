{
	"name": "@gcgov/apiservice",
	"version": "2.5.0",
	"description": "Extendable class that provides default rest API methods built upon Axios",
	"main": "dist/ApiService.mjs",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup",
		"test": "echo \"Error: no test specified\" && exit 1",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"yalc:publish": "tsup && yalc publish --push"
	},
	"dependencies": {
		"@types/web": "^0.0.367",
		"dexie": "^4.0.10",
		"lodash": "^4.17.21",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@types/lodash": "^4.14.202",
		"eslint": "^8.49.0",
		"globals": "^17.14.0",
		"ts-node": "^10.9.2",
		"tsup": "^9.0.0",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.15.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gcgov/apiservice.git"
	},
	"author": "Andrew Sauder",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/gcgov/apiservice/issues"
	},
	"homepage": "https://github.com/gcgov/apiservice#readme",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.0.0 <27.0.0",
			"onFail": "warn"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=11.0.0 <12.0.0",
			"onFail": "warn"
		}
	},
	"allowScripts": {
		"esbuild": true
	}
}
